    "rendered": "\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"16036\" class=\"elementor elementor-16036\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-5273ec4 e-flex e-con-boxed e-con e-parent\" data-id=\"5273ec4\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-70902a8 e-con-full e-flex e-con e-child\" data-id=\"70902a8\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-8e7566c elementor-arrows-position-inside elementor-widget elementor-widget-image-carousel\" data-id=\"8e7566c\" data-element_type=\"widget\" data-e-type=\"widget\" data-settings=\"{&quot;slides_to_show&quot;:&quot;1&quot;,&quot;navigation&quot;:&quot;arrows&quot;,&quot;autoplay&quot;:&quot;yes&quot;,&quot;pause_on_hover&quot;:&quot;yes&quot;,&quot;pause_on_interaction&quot;:&quot;yes&quot;,&quot;autoplay_speed&quot;:5000,&quot;infinite&quot;:&quot;yes&quot;,&quot;effect&quot;:&quot;slide&quot;,&quot;speed&quot;:500}\" data-widget_type=\"image-carousel.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-image-carousel-wrapper swiper\" role=\"region\" aria-roledescription=\"carousel\" aria-label=\"Image Carousel\" dir=\"ltr\">\n\t\t\t<div class=\"elementor-image-carousel swiper-wrapper swiper-image-stretch\" aria-live=\"off\">\n\t\t\t\t\t\t\t\t<div class=\"swiper-slide\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"1 of 2\"><a href=\"https://mgm-school.nbtksa.in/wp-content/uploads/2026/07/1750233724.jpeg\"><figure class=\"swiper-slide-inner\"><img decoding=\"async\" class=\"swiper-slide-image\" src=\"https://mgm-school.nbtksa.in/wp-content/uploads/2026/07/1750233724.jpeg\" alt=\"1750233724\" /></figure></a></div><div class=\"swiper-slide\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"2 of 2\"><a href=\"https://mgm-school.nbtksa.in/wp-content/uploads/2026/07/1750233709.jpeg\"><figure class=\"swiper-slide-inner\"><img decoding=\"async\" class=\"swiper-slide-image\" src=\"https://mgm-school.nbtksa.in/wp-content/uploads/2026/07/1750233709.jpeg\" alt=\"1750233709\" /></figure></a></div>\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-swiper-button elementor-swiper-button-prev\" role=\"button\" tabindex=\"0\">\n\t\t\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-eicon-chevron-left\" viewBox=\"0 0 1000 1000\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M646 125C629 125 613 133 604 142L308 442C296 454 292 471 292 487 292 504 296 521 308 533L604 854C617 867 629 875 646 875 663 875 679 871 692 858 704 846 713 829 713 812 713 796 708 779 692 767L438 487 692 225C700 217 708 204 708 187 708 171 704 154 692 142 675 129 663 125 646 125Z\"></path></svg>\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"elementor-swiper-button elementor-swiper-button-next\" role=\"button\" tabindex=\"0\">\n\t\t\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-eicon-chevron-right\" viewBox=\"0 0 1000 1000\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M696 533C708 521 713 504 713 487 713 471 708 454 696 446L400 146C388 133 375 125 354 125 338 125 325 129 313 142 300 154 292 171 292 187 292 204 296 221 308 233L563 492 304 771C292 783 288 800 288 817 288 833 296 850 308 863 321 871 338 875 354 875 371 875 388 867 400 854L696 533Z\"></path></svg>\t\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-4a139fb e-con-full e-flex e-con e-child\" data-id=\"4a139fb\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<h2 data-interaction-id=\"44e03f8\" class=\"e-44e03f8-9c56304 e-heading-base e-default-h2\">​<strong>\"<u>Voice of MGM\" - Our School Radio Club</u></strong><br></h2>\n\t\t\t\t<div class=\"elementor-element elementor-element-55c629b elementor-widget elementor-widget-text-editor\" data-id=\"55c629b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<div class=\"row sa-row\"><div class=\"col-sm sa-col\"><p style=\"font-weight: 400;\">The &#8220;Voice of MGM&#8221; Radio Club provides a unique platform for students to build confidence, develop public speaking skills, and showcase their creativity. Running a radio show fosters teamwork, communication, and commitment.</p><p style=\"font-weight: 400;\">Our user-friendly systems encourage participation from students of all ages and abilities. Unlike camera or stage performances, speaking into a microphone in a closed room can be less intimidating, allowing students to express themselves freely.</p><p style=\"font-weight: 400;\">​Inaugurated by Rashmi Roja Thushara Nair IAS, Bureau Director of the Press Information Bureau, our Radio Club empowers students to share their ideas and opinions, giving them a confident voice.</p></div></div>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-b889079 e-grid e-con-boxed e-con e-parent\" data-id=\"b889079\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t",
